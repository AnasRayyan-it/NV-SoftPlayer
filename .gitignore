# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# NVDA addon packages & archives
*.nvda-addon
*.zip
*.tar.gz
*.delete
!release/*.nvda-addon
!release/*.zip

# Executables & large binaries
